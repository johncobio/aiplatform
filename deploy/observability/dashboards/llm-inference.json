          "expr": "histogram_quantile(0.99, sum(rate(llm_request_duration_seconds_bucket{environment=\"$environment\",workload=\"$workload\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true
